<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Make the cultured Moyo mass visible while it grows in the abysstech cultivation tank. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/Moyo2.FishDef[defName="Moyo2_FleshMass"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/Moyo2.FishDef[defName="Moyo2_FleshMass"]/fishTankSettings/graphicData/drawSize</xpath>
      <value>
        <drawSize>2</drawSize>
      </value>
    </match>
  </Operation>
</Patch>
